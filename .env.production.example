# MongoDB Atlas Configuration for Production
# ============================================

## Required Environment Variables for Render

# ============================================================================
# MONGODB ATLAS CONNECTION
# ============================================================================

# Connection string format:
# mongodb+srv://<username>:<password>@<cluster-name>..mongodb.net/<database>?retryWrites=true&w=majority

DATABASE_URL=mongodb+srv://advyon_app:YOUR_PASSWORD_HERE@advyon-legal-prod.mongodb.net/advyon_legal?retryWrites=true&w=majority

# Optional: Separate credentials (used by some configurations)
DB_USER=advyon_app
DB_PASSWORD=YOUR_PASSWORD_HERE

# ============================================================================
# DATABASE CONNECTION POOL OPTIONS
# ============================================================================
# These are tuned for Render's containerized environment

DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_SERVER_SELECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000
DB_MAX_IDLE_TIME=30000

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================

NODE_ENV=production
PORT=10000

# ============================================================================
# SECURITY
# ============================================================================

# Generate a strong random string for JWT secrets
JWT_ACCESS_SECRET=your-super-secure-32-character-access-secret-key
JWT_REFRESH_SECRET=your-super-secure-32-character-refresh-secret-key
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

# Password reset link - must be your Vercel frontend URL
RESET_PASS_UI_LINK=https://your-app.vercel.app/reset-password

# ============================================================================
# ADMIN
# ============================================================================

SUPER_ADMIN_PASSWORD=change-this-in-production!
DEFAULT_PASSWORD=ChangeThisPassword123!

# ============================================================================
# CLERK AUTHENTICATION
# ============================================================================

# Get these from Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# CLOUDINARY (Media Storage)
# ============================================================================

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# PAYMENTS (Stripe)
# ============================================================================

# Use LIVE keys for production (from Stripe Dashboard → API keys)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# AI SERVICES
# ============================================================================

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# CORS (Update for production domain)
# ============================================================================

# Replace with your actual Vercel frontend URL after deployment
# Format: https://your-app.vercel.app (comma-separated for multiple)
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-xxx.vercel.app

# ============================================================================
# EMAIL / CONTACT
# ============================================================================

CONTACT_EMAIL_FROM=support@advyon.legal
CONTACT_EMAIL_TO=intake@advyon.legal
CONTACT_SMTP_HOST=smtp.sendgrid.net
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=apikey
CONTACT_SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# FEATURE FLAGS
# ============================================================================

METADATA_DB_ENABLED=true
METADATA_CACHE_TTL_MS=900000
SUPPORT_KPI_ENABLED=true

# ============================================================================
# MAINTENANCE (Optional)
# ============================================================================

# Set to 'true' when running index rebuilds in production
# INDEX_REBUILD_CONFIRMED=false

# ============================================================================
# RENDER SPECIFIC
# ============================================================================

# Build Command: npm run build
# Start Command: npm run prod
