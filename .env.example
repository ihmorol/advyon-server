NODE_ENV=
PORT=
DB_USER=
DB_PASSWORD=
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<db>?retryWrites=true&w=majority

# Database Connection Pool Options (optional, defaults provided)
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_SERVER_SELECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000
DB_MAX_IDLE_TIME=30000

BCRYPT_SALT_ROUNDS=
DEFAULT_PASS=

# JWT Secrets (REQUIRED for production - generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

RESET_PASS_UI_LINK=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPER_ADMIN_PASSWORD=

CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Stripe Payment Integration (test-mode keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

METADATA_DB_ENABLED=true
METADATA_CACHE_TTL_MS=900000

SUPPORT_KPI_ENABLED=true

CONTACT_EMAIL_FROM=support@advyon.legal
CONTACT_EMAIL_TO=intake@advyon.legal
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=advyon
CONTACT_SMTP_PASS=changeme

# AI tool daily usage limit per user (clamped 1-200; default 30)
AI_TOOL_DAILY_LIMIT=30

# Community moderation toxicity threshold, 0-1 (default 0.72)
COMMUNITY_MODERATION_THRESHOLD=0.72

# Max upload size in bytes (default 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Test database used only by Jest integration tests
# TEST_DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/test-db?retryWrites=true&w=majority
